# RepoRetro Configuration
# ==========================================

# Server Port
PORT=3000

# Gemma Inference Endpoint (OpenAI-compatible /v1 format)
# llama-server runs natively or via Docker Compose on port 8080:
#   llama-server: http://localhost:8080/v1
# Start llama-server with:
#   npm run llama-server   (or: docker compose up llama-server)
GEMMA_BASE_URL=http://localhost:8080/v1
GEMMA_API_KEY=not-needed-for-local
GEMMA_MODEL=gemma-2-2b-it

# SQLite Database Cache Path
SQLITE_DB_PATH=./data/reporetro.db

# Inactivity threshold in months to classify a contributor as "Long-Gone"
DEPARTED_CONTRIBUTOR_MONTHS=6

# Git Private Repository Credentials (Optional Fallback)
# ======================================================
# Used when scanning private repositories if no credentials are passed via CLI or Web UI:
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
# GIT_TOKEN=glpat-yourGitLabTokenHere
# GIT_USERNAME=yourUsername
# GIT_PASSWORD=yourPassword
# GIT_SSH_KEY_PATH=~/.ssh/id_ed25519
# GIT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
