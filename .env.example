# RepoRetro Configuration
# ==========================================

# Server Port
PORT=3000

# Gemma Inference Endpoint (OpenAI-compatible /v1 format)
# For local offline inference with llama.cpp or Ollama:
#   llama.cpp: http://localhost:8080/v1
#   Ollama:    http://localhost:11434/v1
# For remote cloud hosted Gemma (Google AI Studio / OpenRouter / Groq / DigitalOcean Gradient):
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
GEMMA_BASE_URL=http://localhost:8080/v1
GEMMA_API_KEY=not-needed-for-local
GEMMA_MODEL=gemma-2-2b-it

# SQLite Database Cache Path
SQLITE_DB_PATH=./data/reporetro.db

# Inactivity threshold in months to classify a contributor as "Long-Gone"
DEPARTED_CONTRIBUTOR_MONTHS=6
